# deploy/install.sh creates the real .env file with random secrets. This file only shows what is in it.

# Your domain, for example crm.ciphermutex.com. Use :80 to run without a domain (no HTTPS).
SITE_ADDRESS=crm.example.com
# The full address people open in the browser. Used in the links sent to customers.
APP_URL=https://crm.example.com
# true with HTTPS (a domain), false without.
COOKIE_SECURE=true

# Secrets. Keep them private and keep a copy somewhere safe.
POSTGRES_PASSWORD=
JWT_SECRET=
# 64 hex characters. Stored website passwords cannot be read without this key, so never lose or change it.
ENCRYPTION_KEY=

APP_TIMEZONE=Asia/Kolkata

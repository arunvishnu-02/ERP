# Copy this file to .env for local development:  cp .env.example .env
# On Hostinger, add the same names under the web app's Environment variables instead of using a file.

# MySQL or MariaDB database. Format: mysql://USER:PASSWORD@HOST:3306/DATABASE
# On Hostinger the host is usually localhost and the user and database names look like u123456789_cx.
# If the password has characters such as @ : / # ? use letters and digits only, or use the DB_* names below.
DATABASE_URL=mysql://cx:cx@127.0.0.1:3306/cx

# Alternative to DATABASE_URL (used only when DATABASE_URL is not set):
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=u123456789_cx
# DB_PASSWORD=your-password
# DB_NAME=u123456789_cx

# 64 hex characters. Encrypts stored website passwords and the mailbox password.
# Make one with:  openssl rand -hex 32
# Never change it later, or the stored passwords cannot be read any more.
ENCRYPTION_KEY=

# The address people open in the browser. Used in the quotation and invoice links sent to customers.
APP_URL=http://localhost:3000

# Optional settings and their defaults
# UPLOAD_DIR=            folder for uploaded files (default: cx-crm-erp-data/uploads in the home folder)
# APP_TIMEZONE=Asia/Kolkata
# DATABASE_POOL_SIZE=5
# RUN_JOBS=true          set to false to switch off the daily reminders

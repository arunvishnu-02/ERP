// CX CRM ERP - Prisma schema (MySQL / MariaDB)
//
// Conventions
// - Every business table carries organizationId (the tenant). The API sets it from the signed-in
//   user on every query.
// - Ids are UUIDs stored as CHAR(36). Money is Decimal(14,2). Dates without a time use @db.Date.
// - Short text is VARCHAR(191), the Prisma default for MySQL. Free text uses @db.Text.
// - Lists of plain values (for example the user ids in a lead rotation) are stored as JSON,
//   because MySQL has no array columns.
// - createdById / updatedById and the *FileId columns are plain id columns without a Prisma
//   relation, to keep User and File free of dozens of back-relations. AuditLog holds the full trail.
// - Notes, comments, attachments, activities and tags are polymorphic: (entityType, entityId).
// - Soft delete: rows with deletedAt set are hidden by the API.
//
// Prisma 7: the database URL lives in prisma.config.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}


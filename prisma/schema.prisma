// ─────────────── 20. Settings & Administration: tenancy and structure ───────────────

model Organization {
  id                      String           @id @default(uuid()) @db.Char(36)
  name                    String
  slug                    String           @unique
  legalName               String?
  gstin                   String?
  pan                     String?
  email                   String?
  phone                   String?
  addressLine1            String?
  addressLine2            String?
  city                    String?
  state                   String?
  stateCode               String? // GST state code, e.g. "32" for Kerala
  pincode                 String?
  country                 String           @default("IN")
  currency                String           @default("INR")
  timezone                String           @default("Asia/Kolkata")
  financialYearStartMonth Int              @default(4)
  logoFileId              String?          @db.Char(36)
  plan                    SubscriptionPlan @default(TRIAL)
  status                  OrgStatus        @default(ACTIVE)
  settings                Json?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  branches            Branch[]
  departments         Department[]
  teams               Team[]
  users               User[]
  roles               Role[]
  apiKeys             ApiKey[]
  auditLogs           AuditLog[]
  files               File[]
  attachments         Attachment[]
  notes               Note[]
  comments            Comment[]
  activities          Activity[]
  tags                Tag[]
  numberSequences     NumberSequence[]
  leadSources         LeadSource[]
  leadStages          LeadStage[]
  leads               Lead[]
  followUps           FollowUp[]
  customers           Customer[]
  contacts            Contact[]
  pipelines           Pipeline[]
  deals               Deal[]
  meetings            Meeting[]
  callLogs            CallLog[]
  services            Service[]
  servicePackages     ServicePackage[]
  priceRules          PriceRule[]
  taxRates            TaxRate[]
  quotations          Quotation[]
  approvalRules       ApprovalRule[]
  approvalRequests    ApprovalRequest[]
  invoiceTemplates    InvoiceTemplate[]
  invoices            Invoice[]
  creditNotes         CreditNote[]
  recurringInvoices   RecurringInvoice[]
  bankAccounts        BankAccount[]
  payments            Payment[]
  paymentReminders    PaymentReminder[]
  projects            Project[]
  tasks               Task[]
  timeEntries         TimeEntry[]
  socialAccounts      SocialAccount[]
  campaigns           Campaign[]
  contentItems        ContentItem[]
  adSpends            AdSpend[]
  campaignReports     CampaignReport[]
  websites            Website[]
  webAssets           WebAsset[]
  credentials         Credential[]
  tickets             Ticket[]
  documentFolders     DocumentFolder[]
  documents           Document[]
  employees           Employee[]
  attendances         Attendance[]
  leaveTypes          LeaveType[]
  leaveRequests       LeaveRequest[]
  holidays            Holiday[]
  performanceReviews  PerformanceReview[]
  assets              Asset[]
  expenseCategories   ExpenseCategory[]
  vendors             Vendor[]
  expenses            Expense[]
  ledgerEntries       LedgerEntry[]
  savedReports        SavedReport[]
  exportJobs          ExportJob[]
  importJobs          ImportJob[]
  dashboardWidgets    DashboardWidget[]
  savedFilters        SavedFilter[]
  automationRules     AutomationRule[]
  automationRuns      AutomationRun[]
  leadAssignmentRules LeadAssignmentRule[]
  messageTemplates    MessageTemplate[]
  messages            Message[]
  notifications       Notification[]
  integrationSettings IntegrationSetting[]
  outboxEvents        OutboxEvent[]
}

model Branch {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @db.Char(36)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  code           String
  gstin          String?
  addressLine1   String?
  city           String?
  state          String?
  stateCode      String?
  pincode        String?
  phone          String?
  isHeadOffice   Boolean      @default(false)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  departments   Department[]
  users         User[]
  userRoles     UserRole[]
  leads         Lead[]
  customers     Customer[]
  deals         Deal[]
  quotations    Quotation[]
  invoices      Invoice[]
  payments      Payment[]
  projects      Project[]
  employees     Employee[]
  holidays      Holiday[]
  assets        Asset[]
  expenses      Expense[]
  ledgerEntries LedgerEntry[]

  @@unique([organizationId, code])
}

model Department {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @db.Char(36)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String?      @db.Char(36)
  branch         Branch?      @relation(fields: [branchId], references: [id])
  name           String
  code           String?
  headId         String?      @db.Char(36)
  head           User?        @relation("DepartmentHead", fields: [headId], references: [id])
  parentId       String?      @db.Char(36)
  parent         Department?  @relation("DepartmentTree", fields: [parentId], references: [id])
  children       Department[] @relation("DepartmentTree")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  teams     Team[]
  members   User[]     @relation("DepartmentMembers")
  employees Employee[]

  @@unique([organizationId, name])
}

model Team {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @db.Char(36)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId   String?      @db.Char(36)
  department     Department?  @relation(fields: [departmentId], references: [id])
  name           String
  leadId         String?      @db.Char(36)
  lead           User?        @relation("TeamLead", fields: [leadId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  members TeamMember[]

  @@unique([organizationId, name])
}

model TeamMember {
  teamId   String   @db.Char(36)
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId   String   @db.Char(36)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now())

  @@id([teamId, userId])
}

// ─────────────── Users, roles and permissions (RBAC) ───────────────

model User {
  id                 String       @id @default(uuid()) @db.Char(36)
  organizationId     String       @db.Char(36)
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId           String?      @db.Char(36)
  branch             Branch?      @relation(fields: [branchId], references: [id])
  departmentId       String?      @db.Char(36)
  department         Department?  @relation("DepartmentMembers", fields: [departmentId], references: [id])
  email              String
  phone              String?
  passwordHash       String
  firstName          String
  lastName           String?
  avatarFileId       String?      @db.Char(36)
  status             UserStatus   @default(INVITED)
  managerId          String?      @db.Char(36)
  manager            User?        @relation("UserManager", fields: [managerId], references: [id])
  reports            User[]       @relation("UserManager")
  twoFactorEnabled   Boolean      @default(false)
  twoFactorSecret    String?
  mustChangePassword Boolean      @default(false)
  emailVerifiedAt    DateTime?
  lastLoginAt        DateTime?
  preferences        Json? // theme (dark mode), locale, default branch
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  deletedAt          DateTime?

  headedDepartments       Department[]             @relation("DepartmentHead")
  ledTeams                Team[]                   @relation("TeamLead")
  teamMemberships         TeamMember[]
  roles                   UserRole[]
  sessions                Session[]
  passwordResetTokens     PasswordResetToken[]
  auditLogs               AuditLog[]
  notes                   Note[]                   @relation("NoteAuthor")
  comments                Comment[]                @relation("CommentAuthor")
  activities              Activity[]               @relation("ActivityActor")
  ownedLeads              Lead[]                   @relation("LeadOwner")
  followUps               FollowUp[]               @relation("FollowUpAssignee")
  managedCustomers        Customer[]               @relation("AccountManager")
  ownedDeals              Deal[]                   @relation("DealOwner")
  organizedMeetings       Meeting[]                @relation("MeetingOrganizer")
  meetingInvites          MeetingAttendee[]        @relation("MeetingAttendee")
  callLogs                CallLog[]                @relation("CallLogUser")
  preparedQuotations      Quotation[]              @relation("QuotationPreparedBy")
  approvalRules           ApprovalRule[]           @relation("ApprovalRuleApprover")
  approvalRequests        ApprovalRequest[]        @relation("ApprovalRequester")
  approvalSteps           ApprovalStep[]           @relation("ApprovalApprover")
  managedProjects         Project[]                @relation("ProjectManager")
  projectMemberships      ProjectMember[]
  assignedTasks           Task[]                   @relation("TaskAssignee")
  reportedTasks           Task[]                   @relation("TaskReporter")
  timeEntries             TimeEntry[]
  managedCampaigns        Campaign[]               @relation("CampaignManager")
  contentItems            ContentItem[]            @relation("ContentAssignee")
  credentialAccessLogs    CredentialAccessLog[]
  assignedTickets         Ticket[]                 @relation("TicketAssignee")
  ownedDocuments          Document[]               @relation("DocumentOwner")
  employee                Employee?
  leaveApprovals          LeaveRequest[]           @relation("LeaveApprover")
  performanceReviews      PerformanceReview[]      @relation("PerformanceReviewer")
  paidExpenses            Expense[]                @relation("ExpensePaidBy")
  savedReports            SavedReport[]            @relation("ReportOwner")
  exportJobs              ExportJob[]              @relation("ExportRequester")
  importJobs              ImportJob[]              @relation("ImportRequester")
  dashboardWidgets        DashboardWidget[]
  savedFilters            SavedFilter[]
  sentMessages            Message[]                @relation("MessageSender")
  notifications           Notification[]
  notificationPreferences NotificationPreference[]

  @@unique([organizationId, email])
  @@index([organizationId, status])
}

model Role {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @db.Char(36)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  key            String // SUPER_ADMIN, MANAGER, SALES_EXECUTIVE, DIGITAL_MARKETING_EXECUTIVE, DEVELOPER, UI_UX_DESIGNER, VIDEO_EDITOR, ACCOUNTS, HR, or a custom key
  description    String?      @db.Text
  isSystem       Boolean      @default(false) // the nine seeded roles cannot be deleted
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  users         UserRole[]
  permissions   RolePermission[]
  approvalRules ApprovalRule[]

  @@unique([organizationId, key])
}

model UserRole {
  userId     String   @db.Char(36)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId     String   @db.Char(36)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  branchId   String?  @db.Char(36) // limits the role to one branch when set
  branch     Branch?  @relation(fields: [branchId], references: [id])
  assignedAt DateTime @default(now())

  @@id([userId, roleId])
}

// Global catalogue: one row per module x action (20 x 7 = 140 rows), seeded once.
model Permission {
  id          String           @id @default(uuid()) @db.Char(36)
  module      ModuleKey
  action      PermissionAction
  description String?          @db.Text

  roles RolePermission[]

  @@unique([module, action])
}

model RolePermission {
  roleId       String      @db.Char(36)
  role         Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String      @db.Char(36)
  permission   Permission  @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  scope        AccessScope @default(OWN)

  @@id([roleId, permissionId])
}

model Session {
  id         String   @id @default(uuid()) @db.Char(36)
  userId     String   @db.Char(36)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique // SHA-256 of the cookie value; the value itself is never stored
  userAgent  String?  @db.Text
  ipAddress  String?
  expiresAt  DateTime
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Char(36)
  userId    String    @db.Char(36)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model ApiKey {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @db.Char(36)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  keyHash        String       @unique
  scopes         Json?
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  revokedAt      DateTime?
  createdById    String?      @db.Char(36)
  createdAt      DateTime     @default(now())
}

model AuditLog {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @db.Char(36)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?      @db.Char(36)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  action         AuditAction
  module         ModuleKey?
  entityType     String
  entityId       String?
  before         Json?
  after          Json?
  ipAddress      String?
  userAgent      String?      @db.Text
  requestId      String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, entityType, entityId])
  @@index([organizationId, userId, createdAt])
  @@index([organizationId, createdAt])
}

// ─────────────── Shared building blocks (used by every module) ───────────────

model File {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @db.Char(36)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bucket         String
  key            String
  fileName       String       @db.VarChar(255)
  mimeType       String
  sizeBytes      BigInt
  checksum       String?
  uploadedById   String?      @db.Char(36)
  createdAt      DateTime     @default(now())

  attachments      Attachment[]
  documentVersions DocumentVersion[]

  @@unique([bucket, key])
}

model Attachment {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @db.Char(36)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fileId         String       @db.Char(36)
  file           File         @relation(fields: [fileId], references: [id], onDelete: Cascade)
  entityType     EntityType
  entityId       String       @db.Char(36)
  createdById    String?      @db.Char(36)
  createdAt      DateTime     @default(now())

  @@index([organizationId, entityType, entityId])
}

model Note {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @db.Char(36)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entityType     EntityType
  entityId       String       @db.Char(36)
  body           String       @db.Text
  isPinned       Boolean      @default(false)
  authorId       String       @db.Char(36)
  author         User         @relation("NoteAuthor", fields: [authorId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, entityType, entityId])
}

model Comment {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @db.Char(36)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entityType     EntityType
  entityId       String       @db.Char(36)
  body           String       @db.Text
  isInternal     Boolean      @default(true) // false = visible to the customer (tickets)
  mentions       Json? // user ids
  authorId       String       @db.Char(36)
  author         User         @relation("CommentAuthor", fields: [authorId], references: [id])
  parentId       String?      @db.Char(36)
  parent         Comment?     @relation("CommentThread", fields: [parentId], references: [id])
  replies        Comment[]    @relation("CommentThread")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  @@index([organizationId, entityType, entityId])
}

// Activity timeline: one row per thing that happened to a record.
model Activity {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @db.Char(36)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entityType     EntityType
  entityId       String       @db.Char(36)
  type           ActivityType
  summary        String       @db.Text
  metadata       Json?
  actorId        String?      @db.Char(36)
  actor          User?        @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  occurredAt     DateTime     @default(now())

  @@index([organizationId, entityType, entityId, occurredAt])
  @@index([organizationId, occurredAt])
}

model Tag {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @db.Char(36)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  color          String?

  assignments TagAssignment[]

  @@unique([organizationId, name])
}

model TagAssignment {
  tagId      String     @db.Char(36)
  tag        Tag        @relation(fields: [tagId], references: [id], onDelete: Cascade)
  entityType EntityType
  entityId   String     @db.Char(36)

  @@id([tagId, entityType, entityId])
  @@index([entityType, entityId])
}

model NumberSequence {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @db.Char(36)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           SequenceType
  prefix         String // e.g. "CX/INV"
  financialYear  String // e.g. "26-27"
  nextNumber     Int          @default(1)
  padding        Int          @default(4)

  @@unique([organizationId, type, financialYear])
}

// ─────────────── 2. Lead Management ───────────────

model LeadSource {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @db.Char(36)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String // Website form, Meta Ads, Google Ads, Referral, WhatsApp, Walk-in ...
  isActive       Boolean      @default(true)

  leads Lead[]

  @@unique([organizationId, name])
}

model LeadStage {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @db.Char(36)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  position       Int
  color          String?
  isDefault      Boolean      @default(false)
  isWon          Boolean      @default(false)
  isLost         Boolean      @default(false)

  leads Lead[]

  @@unique([organizationId, name])
}

model Lead {
  id              String       @id @default(uuid()) @db.Char(36)
  organizationId  String       @db.Char(36)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId        String?      @db.Char(36)
  branch          Branch?      @relation(fields: [branchId], references: [id])
  leadNumber      String
  firstName       String
  lastName        String?
  companyName     String?
  email           String?
  phone           String?
  whatsappNumber  String?
  website         String?      @db.VarChar(500)
  city            String?
  state           String?
  sourceId        String?      @db.Char(36)
  source          LeadSource?  @relation(fields: [sourceId], references: [id])
  stageId         String       @db.Char(36)
  stage           LeadStage    @relation(fields: [stageId], references: [id])
  status          LeadStatus   @default(OPEN)
  serviceInterest Json? // list of ServiceCategory values
  requirement     String?      @db.Text
  estimatedValue  Decimal?     @db.Decimal(14, 2)
  score           Int?
  ownerId         String?      @db.Char(36)
  owner           User?        @relation("LeadOwner", fields: [ownerId], references: [id])
  nextFollowUpAt  DateTime?
  lastContactedAt DateTime?
  lostReason      String?      @db.Text
  convertedAt     DateTime?
  customerId      String?      @db.Char(36) // set when the lead converts
  customer        Customer?    @relation(fields: [customerId], references: [id])
  utm             Json?
  customFields    Json?
  createdById     String?      @db.Char(36)
  updatedById     String?      @db.Char(36)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?

  followUps  FollowUp[]
  deals      Deal[]
  meetings   Meeting[]
  callLogs   CallLog[]
  quotations Quotation[]
  messages   Message[]

  @@unique([organizationId, leadNumber])
  @@index([organizationId, status, stageId])
  @@index([organizationId, ownerId])
  @@index([organizationId, nextFollowUpAt])
  @@index([organizationId, phone])
}

model FollowUp {
  id             String         @id @default(uuid()) @db.Char(36)
  organizationId String         @db.Char(36)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId         String?        @db.Char(36)
  lead           Lead?          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  dealId         String?        @db.Char(36)
  deal           Deal?          @relation(fields: [dealId], references: [id], onDelete: Cascade)
  customerId     String?        @db.Char(36)
  customer       Customer?      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type           FollowUpType
  subject        String?        @db.VarChar(500)
  dueAt          DateTime
  completedAt    DateTime?
  outcome        String?        @db.Text
  status         FollowUpStatus @default(PENDING)
  assignedToId   String         @db.Char(36)
  assignedTo     User           @relation("FollowUpAssignee", fields: [assignedToId], references: [id])
  reminderSentAt DateTime?
  createdById    String?        @db.Char(36)
  updatedById    String?        @db.Char(36)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([organizationId, assignedToId, status, dueAt])
}

// ─────────────── 3. Customer Management ───────────────

model Customer {
  id                  String         @id @default(uuid()) @db.Char(36)
  organizationId      String         @db.Char(36)
  organization        Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId            String?        @db.Char(36)
  branch              Branch?        @relation(fields: [branchId], references: [id])
  customerNumber      String
  type                CustomerType   @default(COMPANY)
  name                String
  legalName           String?
  gstin               String?
  pan                 String?
  industry            String?
  website             String?        @db.VarChar(500)
  email               String?
  phone               String?
  billingAddressLine1 String?
  billingAddressLine2 String?
  billingCity         String?
  billingState        String?
  billingStateCode    String? // decides CGST+SGST or IGST
  billingPincode      String?
  country             String         @default("IN")
  isExport            Boolean        @default(false)
  paymentTermsDays    Int            @default(15)
  creditLimit         Decimal?       @db.Decimal(14, 2)
  accountManagerId    String?        @db.Char(36)
  accountManager      User?          @relation("AccountManager", fields: [accountManagerId], references: [id])
  status              CustomerStatus @default(ACTIVE)
  customFields        Json?
  createdById         String?        @db.Char(36)
  updatedById         String?        @db.Char(36)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  deletedAt           DateTime?

  leads             Lead[]
  followUps         FollowUp[]
  contacts          Contact[]
  deals             Deal[]
  meetings          Meeting[]
  callLogs          CallLog[]
  quotations        Quotation[]
  invoices          Invoice[]
  creditNotes       CreditNote[]
  recurringInvoices RecurringInvoice[]
  payments          Payment[]
  projects          Project[]
  socialAccounts    SocialAccount[]
  campaigns         Campaign[]
  contentItems      ContentItem[]
  websites          Website[]
  webAssets         WebAsset[]
  credentials       Credential[]
  tickets           Ticket[]
  documents         Document[]
  messages          Message[]

  @@unique([organizationId, customerNumber])
  @@index([organizationId, name])
  @@index([organizationId, accountManagerId])
}

model Contact {
  id               String       @id @default(uuid()) @db.Char(36)
  organizationId   String       @db.Char(36)
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId       String       @db.Char(36)
  customer         Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  firstName        String
  lastName         String?
  designation      String?
  email            String?
  phone            String?
  whatsappNumber   String?
  isPrimary        Boolean      @default(false)
  isBillingContact Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  deals            Deal[]
  meetingAttendees MeetingAttendee[]
  callLogs         CallLog[]
  quotations       Quotation[]
  invoices         Invoice[]
  tickets          Ticket[]
  messages         Message[]

  @@index([organizationId, customerId])
}

// ─────────────── 4. Sales CRM ───────────────

model Pipeline {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @db.Char(36)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  isDefault      Boolean      @default(false)

  stages PipelineStage[]
  deals  Deal[]

  @@unique([organizationId, name])
}

model PipelineStage {
  id          String   @id @default(uuid()) @db.Char(36)
  pipelineId  String   @db.Char(36)
  pipeline    Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  name        String
  position    Int
  probability Int      @default(0) // percent
  isWon       Boolean  @default(false)
  isLost      Boolean  @default(false)

  deals Deal[]

  @@unique([pipelineId, name])
}

model Deal {
  id                String        @id @default(uuid()) @db.Char(36)
  organizationId    String        @db.Char(36)
  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId          String?       @db.Char(36)
  branch            Branch?       @relation(fields: [branchId], references: [id])
  dealNumber        String
  title             String        @db.VarChar(500)
  customerId        String?       @db.Char(36)
  customer          Customer?     @relation(fields: [customerId], references: [id])
  leadId            String?       @db.Char(36)
  lead              Lead?         @relation(fields: [leadId], references: [id])
  contactId         String?       @db.Char(36)
  contact           Contact?      @relation(fields: [contactId], references: [id])
  pipelineId        String        @db.Char(36)
  pipeline          Pipeline      @relation(fields: [pipelineId], references: [id])
  stageId           String        @db.Char(36)
  stage             PipelineStage @relation(fields: [stageId], references: [id])
  value             Decimal       @default(0) @db.Decimal(14, 2)
  currency          String        @default("INR")
  expectedCloseDate DateTime?     @db.Date
  closedAt          DateTime?
  status            DealStatus    @default(OPEN)
  lostReason        String?       @db.Text
  ownerId           String        @db.Char(36)
  owner             User          @relation("DealOwner", fields: [ownerId], references: [id])
  createdById       String?       @db.Char(36)
  updatedById       String?       @db.Char(36)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?

  followUps  FollowUp[]
  meetings   Meeting[]
  callLogs   CallLog[]
  quotations Quotation[]
  projects   Project[]

  @@unique([organizationId, dealNumber])
  @@index([organizationId, status, stageId])
  @@index([organizationId, ownerId])
}

model Meeting {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @db.Char(36)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String       @db.VarChar(500)
  leadId         String?      @db.Char(36)
  lead           Lead?        @relation(fields: [leadId], references: [id])
  dealId         String?      @db.Char(36)
  deal           Deal?        @relation(fields: [dealId], references: [id])
  customerId     String?      @db.Char(36)
  customer       Customer?    @relation(fields: [customerId], references: [id])
  startsAt       DateTime
  endsAt         DateTime
  location       String?
  meetingUrl     String?      @db.VarChar(500)
  agenda         String?      @db.Text
  outcome        String?      @db.Text
  organizerId    String       @db.Char(36)
  organizer      User         @relation("MeetingOrganizer", fields: [organizerId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  attendees MeetingAttendee[]

  @@index([organizationId, startsAt])
}

model MeetingAttendee {
  id            String   @id @default(uuid()) @db.Char(36)
  meetingId     String   @db.Char(36)
  meeting       Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId        String?  @db.Char(36)
  user          User?    @relation("MeetingAttendee", fields: [userId], references: [id])
  contactId     String?  @db.Char(36)
  contact       Contact? @relation(fields: [contactId], references: [id])
  externalName  String?
  externalEmail String?
}

model CallLog {
  id              String       @id @default(uuid()) @db.Char(36)
  organizationId  String       @db.Char(36)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId          String?      @db.Char(36)
  lead            Lead?        @relation(fields: [leadId], references: [id])
  dealId          String?      @db.Char(36)
  deal            Deal?        @relation(fields: [dealId], references: [id])
  customerId      String?      @db.Char(36)
  customer        Customer?    @relation(fields: [customerId], references: [id])
  contactId       String?      @db.Char(36)
  contact         Contact?     @relation(fields: [contactId], references: [id])
  direction       Direction
  phone           String
  durationSeconds Int?
  outcome         String?      @db.Text
  notes           String?      @db.Text
  recordingFileId String?      @db.Char(36)
  userId          String       @db.Char(36)
  user            User         @relation("CallLogUser", fields: [userId], references: [id])
  calledAt        DateTime     @default(now())

  @@index([organizationId, calledAt])
}

// ─────────────── 5. Quotation Management (with service catalogue and pricing) ───────────────

model Service {
  id             String          @id @default(uuid()) @db.Char(36)
  organizationId String          @db.Char(36)
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  code           String?
  category       ServiceCategory
  description    String?         @db.Text
  sacCode        String? // GST service accounting code
  unit           String          @default("nos")
  basePrice      Decimal         @db.Decimal(14, 2)
  gstRate        Decimal         @default(18) @db.Decimal(5, 2)
  billingCycle   BillingCycle    @default(ONE_TIME)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  packageItems          ServicePackageItem[]
  priceRules            PriceRule[]
  quotationItems        QuotationItem[]
  invoiceItems          InvoiceItem[]
  recurringInvoiceItems RecurringInvoiceItem[]

  @@unique([organizationId, name])
}

model ServicePackage {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @db.Char(36)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?      @db.Text
  price          Decimal      @db.Decimal(14, 2)
  billingCycle   BillingCycle @default(ONE_TIME)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  items          ServicePackageItem[]
  priceRules     PriceRule[]
  quotationItems QuotationItem[]

  @@unique([organizationId, name])
}

model ServicePackageItem {
  id        String         @id @default(uuid()) @db.Char(36)
  packageId String         @db.Char(36)
  package   ServicePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  serviceId String         @db.Char(36)
  service   Service        @relation(fields: [serviceId], references: [id])
  quantity  Decimal        @default(1) @db.Decimal(12, 2)
  unitPrice Decimal?       @db.Decimal(14, 2)
}

// Dynamic pricing: rules the quotation builder applies on top of the base price.
model PriceRule {
  id                String          @id @default(uuid()) @db.Char(36)
  organizationId    String          @db.Char(36)
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name              String
  type              PriceRuleType
  serviceId         String?         @db.Char(36)
  service           Service?        @relation(fields: [serviceId], references: [id])
  packageId         String?         @db.Char(36)
  package           ServicePackage? @relation(fields: [packageId], references: [id])
  minQuantity       Decimal?        @db.Decimal(12, 2)
  minContractMonths Int?
  customerTier      String?
  discountPercent   Decimal?        @db.Decimal(5, 2)
  discountAmount    Decimal?        @db.Decimal(14, 2)
  validFrom         DateTime?       @db.Date
  validTo           DateTime?       @db.Date
  priority          Int             @default(0)
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model TaxRate {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @db.Char(36)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String // "GST 18%"
  rate           Decimal      @db.Decimal(5, 2)
  isDefault      Boolean      @default(false)
  isActive       Boolean      @default(true)

  @@unique([organizationId, name])
}

model Quotation {
  id                String          @id @default(uuid()) @db.Char(36)
  organizationId    String          @db.Char(36)
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId          String?         @db.Char(36)
  branch            Branch?         @relation(fields: [branchId], references: [id])
  quotationNumber   String
  revision          Int             @default(1)
  parentQuotationId String?         @db.Char(36) // the revision this one replaces
  parentQuotation   Quotation?      @relation("QuotationRevisions", fields: [parentQuotationId], references: [id])
  revisions         Quotation[]     @relation("QuotationRevisions")
  isLatest          Boolean         @default(true)
  customerId        String?         @db.Char(36)
  customer          Customer?       @relation(fields: [customerId], references: [id])
  leadId            String?         @db.Char(36)
  lead              Lead?           @relation(fields: [leadId], references: [id])
  dealId            String?         @db.Char(36)
  deal              Deal?           @relation(fields: [dealId], references: [id])
  contactId         String?         @db.Char(36)
  contact           Contact?        @relation(fields: [contactId], references: [id])
  title             String?         @db.VarChar(500)
  issueDate         DateTime        @db.Date
  validUntil        DateTime        @db.Date
  status            QuotationStatus @default(DRAFT)
  placeOfSupply     String? // state code
  isInterState      Boolean         @default(false)
  currency          String          @default("INR")
  subtotal          Decimal         @default(0) @db.Decimal(14, 2)
  discountTotal     Decimal         @default(0) @db.Decimal(14, 2)
  taxableAmount     Decimal         @default(0) @db.Decimal(14, 2)
  cgstAmount        Decimal         @default(0) @db.Decimal(14, 2)
  sgstAmount        Decimal         @default(0) @db.Decimal(14, 2)
  igstAmount        Decimal         @default(0) @db.Decimal(14, 2)
  totalAmount       Decimal         @default(0) @db.Decimal(14, 2)
  terms             String?         @db.Text
  notes             String?         @db.Text
  pdfFileId         String?         @db.Char(36)
  rejectionNote     String?         @db.Text
  publicToken       String?         @unique // link the customer opens to view and accept
  sentAt            DateTime?
  viewedAt          DateTime?
  acceptedAt        DateTime?
  preparedById      String          @db.Char(36)
  preparedBy        User            @relation("QuotationPreparedBy", fields: [preparedById], references: [id])
  createdById       String?         @db.Char(36)
  updatedById       String?         @db.Char(36)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?

  items    QuotationItem[]
  invoices Invoice[]
  projects Project[]

  @@unique([organizationId, quotationNumber, revision])
  @@index([organizationId, status])
  @@index([organizationId, customerId])
}

model QuotationItem {
  id              String          @id @default(uuid()) @db.Char(36)
  quotationId     String          @db.Char(36)
  quotation       Quotation       @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  serviceId       String?         @db.Char(36)
  service         Service?        @relation(fields: [serviceId], references: [id])
  packageId       String?         @db.Char(36)
  package         ServicePackage? @relation(fields: [packageId], references: [id])
  position        Int             @default(0)
  description     String          @db.Text
  sacCode         String?
  quantity        Decimal         @default(1) @db.Decimal(12, 2)
  unit            String          @default("nos")
  unitPrice       Decimal         @db.Decimal(14, 2)
  discountPercent Decimal         @default(0) @db.Decimal(5, 2)
  taxRate         Decimal         @default(18) @db.Decimal(5, 2)
  taxableAmount   Decimal         @db.Decimal(14, 2)
  cgstAmount      Decimal         @default(0) @db.Decimal(14, 2)
  sgstAmount      Decimal         @default(0) @db.Decimal(14, 2)
  igstAmount      Decimal         @default(0) @db.Decimal(14, 2)
  lineTotal       Decimal         @db.Decimal(14, 2)
  billingCycle    BillingCycle    @default(ONE_TIME)
}

// Generic approval workflow: quotations, expenses, leave, credit notes.
model ApprovalRule {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @db.Char(36)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entityType     EntityType
  stepNumber     Int          @default(1)
  minAmount      Decimal?     @db.Decimal(14, 2)
  maxAmount      Decimal?     @db.Decimal(14, 2)
  approverRoleId String?      @db.Char(36)
  approverRole   Role?        @relation(fields: [approverRoleId], references: [id])
  approverUserId String?      @db.Char(36)
  approverUser   User?        @relation("ApprovalRuleApprover", fields: [approverUserId], references: [id])
  isActive       Boolean      @default(true)
}

model ApprovalRequest {
  id             String         @id @default(uuid()) @db.Char(36)
  organizationId String         @db.Char(36)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entityType     EntityType
  entityId       String         @db.Char(36)
  status         ApprovalStatus @default(PENDING)
  currentStep    Int            @default(1)
  requestedById  String         @db.Char(36)
  requestedBy    User           @relation("ApprovalRequester", fields: [requestedById], references: [id])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  steps ApprovalStep[]

  @@index([organizationId, entityType, entityId])
  @@index([organizationId, status])
}

model ApprovalStep {
  id                String          @id @default(uuid()) @db.Char(36)
  approvalRequestId String          @db.Char(36)
  approvalRequest   ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  stepNumber        Int
  approverId        String          @db.Char(36)
  approver          User            @relation("ApprovalApprover", fields: [approverId], references: [id])
  status            ApprovalStatus  @default(PENDING)
  comment           String?         @db.Text
  decidedAt         DateTime?

  @@unique([approvalRequestId, stepNumber])
}

// ─────────────── 6. Invoice Management ───────────────

model InvoiceTemplate {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @db.Char(36)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  layout         Json // header, colours, columns, footer, bank details, terms
  isDefault      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  invoices Invoice[]
}

model Invoice {
  id                 String            @id @default(uuid()) @db.Char(36)
  organizationId     String            @db.Char(36)
  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId           String?           @db.Char(36)
  branch             Branch?           @relation(fields: [branchId], references: [id])
  invoiceNumber      String
  type               InvoiceType       @default(TAX_INVOICE)
  customerId         String            @db.Char(36)
  customer           Customer          @relation(fields: [customerId], references: [id])
  contactId          String?           @db.Char(36)
  contact            Contact?          @relation(fields: [contactId], references: [id])
  projectId          String?           @db.Char(36)
  project            Project?          @relation(fields: [projectId], references: [id])
  quotationId        String?           @db.Char(36)
  quotation          Quotation?        @relation(fields: [quotationId], references: [id])
  recurringInvoiceId String?           @db.Char(36)
  recurringInvoice   RecurringInvoice? @relation(fields: [recurringInvoiceId], references: [id])
  templateId         String?           @db.Char(36)
  template           InvoiceTemplate?  @relation(fields: [templateId], references: [id])
  issueDate          DateTime          @db.Date
  dueDate            DateTime          @db.Date
  paymentTermsDays   Int               @default(15)
  status             InvoiceStatus     @default(DRAFT)
  placeOfSupply      String?
  isInterState       Boolean           @default(false)
  currency           String            @default("INR")
  subtotal           Decimal           @default(0) @db.Decimal(14, 2)
  discountTotal      Decimal           @default(0) @db.Decimal(14, 2)
  taxableAmount      Decimal           @default(0) @db.Decimal(14, 2)
  cgstAmount         Decimal           @default(0) @db.Decimal(14, 2)
  sgstAmount         Decimal           @default(0) @db.Decimal(14, 2)
  igstAmount         Decimal           @default(0) @db.Decimal(14, 2)
  totalAmount        Decimal           @default(0) @db.Decimal(14, 2)
  amountPaid         Decimal           @default(0) @db.Decimal(14, 2)
  tdsAmount          Decimal           @default(0) @db.Decimal(14, 2)
  creditedAmount     Decimal           @default(0) @db.Decimal(14, 2)
  balanceDue         Decimal           @default(0) @db.Decimal(14, 2)
  terms              String?           @db.Text
  notes              String?           @db.Text
  pdfFileId          String?           @db.Char(36)
  publicToken        String?           @unique
  sentAt             DateTime?
  viewedAt           DateTime?
  paidAt             DateTime?
  createdById        String?           @db.Char(36)
  updatedById        String?           @db.Char(36)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  deletedAt          DateTime?

  items              InvoiceItem[]
  creditNotes        CreditNote[]
  paymentAllocations PaymentAllocation[]
  paymentReminders   PaymentReminder[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId, status, dueDate])
  @@index([organizationId, customerId])
  @@index([organizationId, issueDate])
}

model InvoiceItem {
  id              String     @id @default(uuid()) @db.Char(36)
  invoiceId       String     @db.Char(36)
  invoice         Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  serviceId       String?    @db.Char(36)
  service         Service?   @relation(fields: [serviceId], references: [id])
  milestoneId     String?    @db.Char(36)
  milestone       Milestone? @relation(fields: [milestoneId], references: [id])
  position        Int        @default(0)
  description     String     @db.Text
  sacCode         String?
  quantity        Decimal    @default(1) @db.Decimal(12, 2)
  unit            String     @default("nos")
  unitPrice       Decimal    @db.Decimal(14, 2)
  discountPercent Decimal    @default(0) @db.Decimal(5, 2)
  taxRate         Decimal    @default(18) @db.Decimal(5, 2)
  taxableAmount   Decimal    @db.Decimal(14, 2)
  cgstAmount      Decimal    @default(0) @db.Decimal(14, 2)
  sgstAmount      Decimal    @default(0) @db.Decimal(14, 2)
  igstAmount      Decimal    @default(0) @db.Decimal(14, 2)
  lineTotal       Decimal    @db.Decimal(14, 2)
}

model CreditNote {
  id               String           @id @default(uuid()) @db.Char(36)
  organizationId   String           @db.Char(36)
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creditNoteNumber String
  invoiceId        String           @db.Char(36)
  invoice          Invoice          @relation(fields: [invoiceId], references: [id])
  customerId       String           @db.Char(36)
  customer         Customer         @relation(fields: [customerId], references: [id])
  issueDate        DateTime         @db.Date
  reason           String           @db.Text
  status           CreditNoteStatus @default(DRAFT)
  taxableAmount    Decimal          @default(0) @db.Decimal(14, 2)
  cgstAmount       Decimal          @default(0) @db.Decimal(14, 2)
  sgstAmount       Decimal          @default(0) @db.Decimal(14, 2)
  igstAmount       Decimal          @default(0) @db.Decimal(14, 2)
  totalAmount      Decimal          @default(0) @db.Decimal(14, 2)
  pdfFileId        String?          @db.Char(36)
  createdById      String?          @db.Char(36)
  updatedById      String?          @db.Char(36)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  items CreditNoteItem[]

  @@unique([organizationId, creditNoteNumber])
}

model CreditNoteItem {
  id            String     @id @default(uuid()) @db.Char(36)
  creditNoteId  String     @db.Char(36)
  creditNote    CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  description   String     @db.Text
  sacCode       String?
  quantity      Decimal    @default(1) @db.Decimal(12, 2)
  unitPrice     Decimal    @db.Decimal(14, 2)
  taxRate       Decimal    @default(18) @db.Decimal(5, 2)
  taxableAmount Decimal    @db.Decimal(14, 2)
  lineTotal     Decimal    @db.Decimal(14, 2)
}

model RecurringInvoice {
  id               String          @id @default(uuid()) @db.Char(36)
  organizationId   String          @db.Char(36)
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId       String          @db.Char(36)
  customer         Customer        @relation(fields: [customerId], references: [id])
  projectId        String?         @db.Char(36)
  project          Project?        @relation(fields: [projectId], references: [id])
  title            String          @db.VarChar(500)
  frequency        BillingCycle
  intervalCount    Int             @default(1)
  startDate        DateTime        @db.Date
  endDate          DateTime?       @db.Date
  nextRunDate      DateTime        @db.Date
  lastRunDate      DateTime?       @db.Date
  paymentTermsDays Int             @default(15)
  autoSend         Boolean         @default(false)
  status           RecurringStatus @default(ACTIVE)
  createdById      String?         @db.Char(36)
  updatedById      String?         @db.Char(36)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  invoices Invoice[]
  items    RecurringInvoiceItem[]

  @@index([organizationId, status, nextRunDate])
}

model RecurringInvoiceItem {
  id                 String           @id @default(uuid()) @db.Char(36)
  recurringInvoiceId String           @db.Char(36)
  recurringInvoice   RecurringInvoice @relation(fields: [recurringInvoiceId], references: [id], onDelete: Cascade)
  serviceId          String?          @db.Char(36)
  service            Service?         @relation(fields: [serviceId], references: [id])
  description        String           @db.Text
  sacCode            String?
  quantity           Decimal          @default(1) @db.Decimal(12, 2)
  unitPrice          Decimal          @db.Decimal(14, 2)
  taxRate            Decimal          @default(18) @db.Decimal(5, 2)
}

// ─────────────── 7. Payment Management ───────────────

model BankAccount {
  id                 String       @id @default(uuid()) @db.Char(36)
  organizationId     String       @db.Char(36)
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name               String
  bankName           String?
  accountNumberLast4 String?
  ifsc               String?
  upiId              String?
  openingBalance     Decimal      @default(0) @db.Decimal(14, 2)
  isDefault          Boolean      @default(false)
  isActive           Boolean      @default(true)

  payments      Payment[]
  expenses      Expense[]
  ledgerEntries LedgerEntry[]
}

model Payment {
  id               String        @id @default(uuid()) @db.Char(36)
  organizationId   String        @db.Char(36)
  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId         String?       @db.Char(36)
  branch           Branch?       @relation(fields: [branchId], references: [id])
  receiptNumber    String
  customerId       String        @db.Char(36)
  customer         Customer      @relation(fields: [customerId], references: [id])
  paymentDate      DateTime      @db.Date
  amount           Decimal       @db.Decimal(14, 2)
  tdsAmount        Decimal       @default(0) @db.Decimal(14, 2)
  method           PaymentMethod
  referenceNumber  String? // UTR, cheque number, gateway id
  bankAccountId    String?       @db.Char(36)
  bankAccount      BankAccount?  @relation(fields: [bankAccountId], references: [id])
  status           PaymentStatus @default(RECEIVED)
  gatewayProvider  String?
  gatewayPaymentId String?
  notes            String?       @db.Text
  receiptFileId    String?       @db.Char(36)
  createdById      String?       @db.Char(36)
  updatedById      String?       @db.Char(36)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  allocations PaymentAllocation[]

  @@unique([organizationId, receiptNumber])
  @@index([organizationId, paymentDate])
  @@index([organizationId, customerId])
}

// One payment can settle several invoices; one invoice can be paid in parts.
model PaymentAllocation {
  id        String  @id @default(uuid()) @db.Char(36)
  paymentId String  @db.Char(36)
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceId String  @db.Char(36)
  invoice   Invoice @relation(fields: [invoiceId], references: [id])
  amount    Decimal @db.Decimal(14, 2)
  tdsAmount Decimal @default(0) @db.Decimal(14, 2)

  @@unique([paymentId, invoiceId])
}

model PaymentReminder {
  id             String              @id @default(uuid()) @db.Char(36)
  organizationId String              @db.Char(36)
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoiceId      String              @db.Char(36)
  invoice        Invoice             @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  channel        NotificationChannel
  level          Int                 @default(1) // 1 = before due, 2 = on due date, 3+ = overdue escalation
  scheduledAt    DateTime
  sentAt         DateTime?
  status         ReminderStatus      @default(SCHEDULED)

  @@index([organizationId, status, scheduledAt])
}

// ─────────────── 8. Project Management ───────────────

model Project {
  id              String          @id @default(uuid()) @db.Char(36)
  organizationId  String          @db.Char(36)
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId        String?         @db.Char(36)
  branch          Branch?         @relation(fields: [branchId], references: [id])
  projectNumber   String
  name            String
  description     String?         @db.Text
  customerId      String          @db.Char(36)
  customer        Customer        @relation(fields: [customerId], references: [id])
  quotationId     String?         @db.Char(36)
  quotation       Quotation?      @relation(fields: [quotationId], references: [id])
  dealId          String?         @db.Char(36)
  deal            Deal?           @relation(fields: [dealId], references: [id])
  category        ServiceCategory
  status          ProjectStatus   @default(PLANNING)
  priority        Priority        @default(MEDIUM)
  startDate       DateTime?       @db.Date
  dueDate         DateTime?       @db.Date
  completedAt     DateTime?
  budget          Decimal?        @db.Decimal(14, 2)
  progressPercent Int             @default(0)
  managerId       String          @db.Char(36)
  manager         User            @relation("ProjectManager", fields: [managerId], references: [id])
  createdById     String?         @db.Char(36)
  updatedById     String?         @db.Char(36)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?

  invoices          Invoice[]
  recurringInvoices RecurringInvoice[]
  members           ProjectMember[]
  milestones        Milestone[]
  tasks             Task[]
  timeEntries       TimeEntry[]
  campaigns         Campaign[]
  websites          Website[]
  tickets           Ticket[]
  documents         Document[]
  expenses          Expense[]

  @@unique([organizationId, projectNumber])
  @@index([organizationId, status])
  @@index([organizationId, customerId])
  @@index([organizationId, managerId])
}

model ProjectMember {
  id            String   @id @default(uuid()) @db.Char(36)
  projectId     String   @db.Char(36)
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId        String   @db.Char(36)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleInProject String?
  hourlyCost    Decimal? @db.Decimal(14, 2)
  joinedAt      DateTime @default(now())

  @@unique([projectId, userId])
}

model Milestone {
  id          String          @id @default(uuid()) @db.Char(36)
  projectId   String          @db.Char(36)
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  description String?         @db.Text
  position    Int             @default(0)
  dueDate     DateTime?       @db.Date
  completedAt DateTime?
  status      MilestoneStatus @default(PENDING)
  isBillable  Boolean         @default(false)
  amount      Decimal?        @db.Decimal(14, 2) // billed when the milestone completes

  invoiceItems InvoiceItem[]
  tasks        Task[]

  @@index([projectId])
}

// ─────────────── 9. Task Management ───────────────

model Task {
  id               String       @id @default(uuid()) @db.Char(36)
  organizationId   String       @db.Char(36)
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  taskNumber       String
  title            String       @db.VarChar(500)
  description      String?      @db.Text
  projectId        String?      @db.Char(36)
  project          Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestoneId      String?      @db.Char(36)
  milestone        Milestone?   @relation(fields: [milestoneId], references: [id])
  parentTaskId     String?      @db.Char(36)
  parentTask       Task?        @relation("SubTasks", fields: [parentTaskId], references: [id])
  subTasks         Task[]       @relation("SubTasks")
  ticketId         String?      @db.Char(36)
  ticket           Ticket?      @relation(fields: [ticketId], references: [id])
  campaignId       String?      @db.Char(36)
  campaign         Campaign?    @relation(fields: [campaignId], references: [id])
  contentItemId    String?      @db.Char(36)
  contentItem      ContentItem? @relation(fields: [contentItemId], references: [id])
  status           TaskStatus   @default(TODO)
  priority         Priority     @default(MEDIUM)
  startDate        DateTime?    @db.Date
  dueDate          DateTime?
  completedAt      DateTime?
  estimatedMinutes Int?
  loggedMinutes    Int          @default(0)
  boardPosition    Float        @default(0)
  assigneeId       String?      @db.Char(36)
  assignee         User?        @relation("TaskAssignee", fields: [assigneeId], references: [id])
  reporterId       String       @db.Char(36)
  reporter         User         @relation("TaskReporter", fields: [reporterId], references: [id])
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  deletedAt        DateTime?

  timeEntries TimeEntry[]

  @@unique([organizationId, taskNumber])
  @@index([organizationId, assigneeId, status, dueDate])
  @@index([organizationId, projectId, status])
}

model TimeEntry {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @db.Char(36)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  taskId         String?      @db.Char(36)
  task           Task?        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  projectId      String?      @db.Char(36)
  project        Project?     @relation(fields: [projectId], references: [id])
  userId         String       @db.Char(36)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt      DateTime
  endedAt        DateTime?
  minutes        Int          @default(0)
  isBillable     Boolean      @default(true)
  description    String?      @db.Text
  createdAt      DateTime     @default(now())

  @@index([organizationId, userId, startedAt])
}

// ─────────────── 10. Digital Marketing ───────────────

model SocialAccount {
  id             String         @id @default(uuid()) @db.Char(36)
  organizationId String         @db.Char(36)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId     String         @db.Char(36)
  customer       Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  platform       SocialPlatform
  handle         String
  profileUrl     String?        @db.VarChar(500)

  @@unique([customerId, platform, handle])
}

model Campaign {
  id             String         @id @default(uuid()) @db.Char(36)
  organizationId String         @db.Char(36)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId     String         @db.Char(36)
  customer       Customer       @relation(fields: [customerId], references: [id])
  projectId      String?        @db.Char(36)
  project        Project?       @relation(fields: [projectId], references: [id])
  name           String
  objective      String?        @db.Text
  platforms      Json? // list of SocialPlatform values
  status         CampaignStatus @default(DRAFT)
  startDate      DateTime       @db.Date
  endDate        DateTime?      @db.Date
  budget         Decimal?       @db.Decimal(14, 2) // total ad budget
  managerId      String         @db.Char(36)
  manager        User           @relation("CampaignManager", fields: [managerId], references: [id])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  tasks        Task[]
  contentItems ContentItem[]
  adSpends     AdSpend[]
  reports      CampaignReport[]
  expenses     Expense[]

  @@index([organizationId, customerId, status])
}

// Content calendar, poster tracking and reel tracking are all ContentItem rows, split by type.
model ContentItem {
  id             String         @id @default(uuid()) @db.Char(36)
  organizationId String         @db.Char(36)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId     String         @db.Char(36)
  customer       Customer       @relation(fields: [customerId], references: [id])
  campaignId     String?        @db.Char(36)
  campaign       Campaign?      @relation(fields: [campaignId], references: [id])
  type           ContentType
  title          String         @db.VarChar(500)
  caption        String?        @db.Text
  platform       SocialPlatform
  scheduledAt    DateTime?
  publishedAt    DateTime?
  status         ContentStatus  @default(IDEA)
  assigneeId     String?        @db.Char(36) // designer or video editor
  assignee       User?          @relation("ContentAssignee", fields: [assigneeId], references: [id])
  revisionCount  Int            @default(0)
  postUrl        String?        @db.VarChar(500)
  metrics        Json? // reach, likes, views, saves pulled or entered after publishing
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  tasks Task[]

  @@index([organizationId, scheduledAt])
  @@index([organizationId, customerId, status])
}

model AdSpend {
  id             String         @id @default(uuid()) @db.Char(36)
  organizationId String         @db.Char(36)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaignId     String         @db.Char(36)
  campaign       Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  platform       SocialPlatform
  spendDate      DateTime       @db.Date
  amount         Decimal        @db.Decimal(14, 2)
  impressions    Int?
  clicks         Int?
  leads          Int?
  conversions    Int?

  @@unique([campaignId, platform, spendDate])
}

model CampaignReport {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @db.Char(36)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaignId     String       @db.Char(36)
  campaign       Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  periodStart    DateTime     @db.Date
  periodEnd      DateTime     @db.Date
  metrics        Json
  summary        String?      @db.Text
  fileId         String?      @db.Char(36)
  sentAt         DateTime?
  createdById    String?      @db.Char(36)
  createdAt      DateTime     @default(now())
}

// ─────────────── 11. Website Management ───────────────

model Website {
  id                String        @id @default(uuid()) @db.Char(36)
  organizationId    String        @db.Char(36)
  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId        String        @db.Char(36)
  customer          Customer      @relation(fields: [customerId], references: [id])
  projectId         String?       @db.Char(36)
  project           Project?      @relation(fields: [projectId], references: [id])
  name              String
  url               String        @db.VarChar(500)
  platform          String? // WordPress, Shopify, Next.js ...
  status            WebsiteStatus @default(IN_DEVELOPMENT)
  monitoringEnabled Boolean       @default(true)
  lastCheckedAt     DateTime?
  lastStatusCode    Int?
  notes             String?       @db.Text
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  webAssets   WebAsset[]
  credentials Credential[]
  tickets     Ticket[]

  @@index([organizationId, customerId])
}

// Domains, hosting plans, SSL certificates and other things that expire.
model WebAsset {
  id                 String        @id @default(uuid()) @db.Char(36)
  organizationId     String        @db.Char(36)
  organization       Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId         String        @db.Char(36)
  customer           Customer      @relation(fields: [customerId], references: [id])
  websiteId          String?       @db.Char(36)
  website            Website?      @relation(fields: [websiteId], references: [id])
  type               WebAssetType
  name               String // example.com, "Business hosting plan"
  provider           String?
  ownedBy            AssetOwner    @default(AGENCY)
  purchaseDate       DateTime?     @db.Date
  expiryDate         DateTime      @db.Date
  renewalCost        Decimal?      @db.Decimal(14, 2) // what the provider charges
  billingAmount      Decimal?      @db.Decimal(14, 2) // what the customer is charged
  autoRenew          Boolean       @default(false)
  status             RenewalStatus @default(ACTIVE)
  reminderDaysBefore Json?
  lastReminderAt     DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([organizationId, expiryDate])
  @@index([organizationId, customerId])
}

// Secrets are encrypted in the application (AES-256-GCM, key from KMS) before they reach the database.
model Credential {
  id               String         @id @default(uuid()) @db.Char(36)
  organizationId   String         @db.Char(36)
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId       String?        @db.Char(36)
  customer         Customer?      @relation(fields: [customerId], references: [id])
  websiteId        String?        @db.Char(36)
  website          Website?       @relation(fields: [websiteId], references: [id])
  label            String
  type             CredentialType
  url              String?        @db.VarChar(500)
  username         String?
  secretCiphertext Bytes
  secretIv         Bytes
  secretAuthTag    Bytes
  keyVersion       Int            @default(1)
  notes            String?        @db.Text
  lastRotatedAt    DateTime?
  createdById      String?        @db.Char(36)
  updatedById      String?        @db.Char(36)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  accessLogs CredentialAccessLog[]
}

model CredentialAccessLog {
  id           String                 @id @default(uuid()) @db.Char(36)
  credentialId String                 @db.Char(36)
  credential   Credential             @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  userId       String                 @db.Char(36)
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  action       CredentialAccessAction
  ipAddress    String?
  accessedAt   DateTime               @default(now())

  @@index([credentialId, accessedAt])
}

// ─────────────── 12. Support Tickets ───────────────

model Ticket {
  id              String        @id @default(uuid()) @db.Char(36)
  organizationId  String        @db.Char(36)
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ticketNumber    String
  customerId      String        @db.Char(36)
  customer        Customer      @relation(fields: [customerId], references: [id])
  contactId       String?       @db.Char(36)
  contact         Contact?      @relation(fields: [contactId], references: [id])
  projectId       String?       @db.Char(36)
  project         Project?      @relation(fields: [projectId], references: [id])
  websiteId       String?       @db.Char(36)
  website         Website?      @relation(fields: [websiteId], references: [id])
  subject         String        @db.VarChar(500)
  description     String        @db.Text
  category        String?
  channel         TicketChannel @default(INTERNAL)
  priority        Priority      @default(MEDIUM)
  status          TicketStatus  @default(OPEN)
  assigneeId      String?       @db.Char(36)
  assignee        User?         @relation("TicketAssignee", fields: [assigneeId], references: [id])
  resolutionNotes String?       @db.Text
  firstResponseAt DateTime?
  slaDueAt        DateTime?
  resolvedAt      DateTime?
  closedAt        DateTime?
  createdById     String?       @db.Char(36)
  updatedById     String?       @db.Char(36)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  tasks Task[]

  @@unique([organizationId, ticketNumber])
  @@index([organizationId, status, priority])
  @@index([organizationId, assigneeId])
}

// ─────────────── 13. Document Management ───────────────

model DocumentFolder {
  id             String           @id @default(uuid()) @db.Char(36)
  organizationId String           @db.Char(36)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  category       DocumentCategory @default(OTHER)
  parentId       String?          @db.Char(36)
  parent         DocumentFolder?  @relation("FolderTree", fields: [parentId], references: [id])
  children       DocumentFolder[] @relation("FolderTree")

  documents Document[]
}

model Document {
  id             String           @id @default(uuid()) @db.Char(36)
  organizationId String           @db.Char(36)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  folderId       String?          @db.Char(36)
  folder         DocumentFolder?  @relation(fields: [folderId], references: [id])
  category       DocumentCategory
  title          String           @db.VarChar(500)
  description    String?          @db.Text
  customerId     String?          @db.Char(36)
  customer       Customer?        @relation(fields: [customerId], references: [id])
  projectId      String?          @db.Char(36)
  project        Project?         @relation(fields: [projectId], references: [id])
  employeeId     String?          @db.Char(36)
  employee       Employee?        @relation(fields: [employeeId], references: [id])
  status         DocumentStatus   @default(ACTIVE)
  currentVersion Int              @default(1)
  expiresAt      DateTime?        @db.Date
  ownerId        String           @db.Char(36)
  owner          User             @relation("DocumentOwner", fields: [ownerId], references: [id])
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?

  versions DocumentVersion[]

  @@index([organizationId, category])
}

model DocumentVersion {
  id           String   @id @default(uuid()) @db.Char(36)
  documentId   String   @db.Char(36)
  document     Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version      Int
  fileId       String   @db.Char(36)
  file         File     @relation(fields: [fileId], references: [id])
  changeNote   String?  @db.Text
  uploadedById String?  @db.Char(36)
  createdAt    DateTime @default(now())

  @@unique([documentId, version])
}

// ─────────────── 14. HR ───────────────

model Employee {
  id                   String         @id @default(uuid()) @db.Char(36)
  organizationId       String         @db.Char(36)
  organization         Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId               String?        @unique @db.Char(36) // the login for this employee, if any
  user                 User?          @relation(fields: [userId], references: [id])
  branchId             String?        @db.Char(36)
  branch               Branch?        @relation(fields: [branchId], references: [id])
  departmentId         String?        @db.Char(36)
  department           Department?    @relation(fields: [departmentId], references: [id])
  employeeCode         String
  firstName            String
  lastName             String?
  designation          String
  employmentType       EmploymentType @default(FULL_TIME)
  dateOfJoining        DateTime       @db.Date
  dateOfBirth          DateTime?      @db.Date
  gender               String?
  personalEmail        String?
  phone                String?
  emergencyContact     Json?
  address              String?        @db.Text
  panEncrypted         Bytes?
  bankDetailsEncrypted Bytes?
  ctcAnnual            Decimal?       @db.Decimal(14, 2)
  reportingManagerId   String?        @db.Char(36)
  reportingManager     Employee?      @relation("ReportingLine", fields: [reportingManagerId], references: [id])
  directReports        Employee[]     @relation("ReportingLine")
  status               EmployeeStatus @default(ACTIVE)
  exitDate             DateTime?      @db.Date
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  documents          Document[]
  attendances        Attendance[]
  leaveBalances      LeaveBalance[]
  leaveRequests      LeaveRequest[]
  performanceReviews PerformanceReview[]
  assetAssignments   AssetAssignment[]

  @@unique([organizationId, employeeCode])
  @@index([organizationId, status])
}

model Attendance {
  id             String           @id @default(uuid()) @db.Char(36)
  organizationId String           @db.Char(36)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeId     String           @db.Char(36)
  employee       Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date           DateTime         @db.Date
  status         AttendanceStatus
  checkInAt      DateTime?
  checkOutAt     DateTime?
  workMinutes    Int?
  source         AttendanceSource @default(WEB)
  notes          String?          @db.Text

  @@unique([employeeId, date])
  @@index([organizationId, date])
}

model LeaveType {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @db.Char(36)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  code           String
  annualQuota    Decimal      @default(0) @db.Decimal(12, 2)
  isPaid         Boolean      @default(true)
  carryForward   Boolean      @default(false)

  balances      LeaveBalance[]
  leaveRequests LeaveRequest[]

  @@unique([organizationId, code])
}

model LeaveBalance {
  id          String    @id @default(uuid()) @db.Char(36)
  employeeId  String    @db.Char(36)
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId String    @db.Char(36)
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  year        Int
  allotted    Decimal   @default(0) @db.Decimal(12, 2)
  used        Decimal   @default(0) @db.Decimal(12, 2)

  @@unique([employeeId, leaveTypeId, year])
}

model LeaveRequest {
  id             String         @id @default(uuid()) @db.Char(36)
  organizationId String         @db.Char(36)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeId     String         @db.Char(36)
  employee       Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId    String         @db.Char(36)
  leaveType      LeaveType      @relation(fields: [leaveTypeId], references: [id])
  startDate      DateTime       @db.Date
  endDate        DateTime       @db.Date
  days           Decimal        @db.Decimal(12, 2)
  reason         String?        @db.Text
  status         ApprovalStatus @default(PENDING)
  approverId     String?        @db.Char(36)
  approver       User?          @relation("LeaveApprover", fields: [approverId], references: [id])
  decidedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([organizationId, status])
}

model Holiday {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @db.Char(36)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String?      @db.Char(36) // null = applies to every branch
  branch         Branch?      @relation(fields: [branchId], references: [id])
  name           String
  date           DateTime     @db.Date
  isOptional     Boolean      @default(false)

  @@index([organizationId, date])
}

model PerformanceReview {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @db.Char(36)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeId     String       @db.Char(36)
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  reviewerId     String       @db.Char(36)
  reviewer       User         @relation("PerformanceReviewer", fields: [reviewerId], references: [id])
  periodStart    DateTime     @db.Date
  periodEnd      DateTime     @db.Date
  rating         Decimal?     @db.Decimal(5, 2)
  goals          Json?
  strengths      String?      @db.Text
  improvements   String?      @db.Text
  status         ReviewStatus @default(DRAFT)
  submittedAt    DateTime?
  acknowledgedAt DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

// ─────────────── 15. Asset Management ───────────────

model Asset {
  id                String        @id @default(uuid()) @db.Char(36)
  organizationId    String        @db.Char(36)
  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId          String?       @db.Char(36)
  branch            Branch?       @relation(fields: [branchId], references: [id])
  assetTag          String
  name              String
  category          AssetCategory
  serialNumber      String?
  vendorName        String?
  purchaseDate      DateTime?     @db.Date
  purchaseCost      Decimal?      @db.Decimal(14, 2)
  warrantyExpiresAt DateTime?     @db.Date
  status            AssetStatus   @default(AVAILABLE)
  condition         String?       @db.Text
  notes             String?       @db.Text
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  assignments        AssetAssignment[]
  maintenanceRecords AssetMaintenance[]

  @@unique([organizationId, assetTag])
}

model AssetAssignment {
  id                String    @id @default(uuid()) @db.Char(36)
  assetId           String    @db.Char(36)
  asset             Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  employeeId        String    @db.Char(36)
  employee          Employee  @relation(fields: [employeeId], references: [id])
  assignedAt        DateTime  @default(now())
  returnedAt        DateTime?
  conditionOnAssign String?   @db.Text
  conditionOnReturn String?   @db.Text
  assignedById      String?   @db.Char(36)

  @@index([assetId, returnedAt])
}

model AssetMaintenance {
  id          String    @id @default(uuid()) @db.Char(36)
  assetId     String    @db.Char(36)
  asset       Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  type        String // repair, service, upgrade
  description String    @db.Text
  vendorName  String?
  cost        Decimal?  @db.Decimal(14, 2)
  performedAt DateTime  @db.Date
  nextDueAt   DateTime? @db.Date
}

// ─────────────── 16. Finance ───────────────

model ExpenseCategory {
  id             String            @id @default(uuid()) @db.Char(36)
  organizationId String            @db.Char(36)
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  parentId       String?           @db.Char(36)
  parent         ExpenseCategory?  @relation("ExpenseCategoryTree", fields: [parentId], references: [id])
  children       ExpenseCategory[] @relation("ExpenseCategoryTree")

  expenses Expense[]

  @@unique([organizationId, name])
}

model Vendor {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @db.Char(36)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  gstin          String?
  email          String?
  phone          String?
  notes          String?      @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  expenses Expense[]

  @@unique([organizationId, name])
}

model Expense {
  id             String          @id @default(uuid()) @db.Char(36)
  organizationId String          @db.Char(36)
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String?         @db.Char(36)
  branch         Branch?         @relation(fields: [branchId], references: [id])
  expenseNumber  String
  categoryId     String          @db.Char(36)
  category       ExpenseCategory @relation(fields: [categoryId], references: [id])
  vendorId       String?         @db.Char(36)
  vendor         Vendor?         @relation(fields: [vendorId], references: [id])
  projectId      String?         @db.Char(36)
  project        Project?        @relation(fields: [projectId], references: [id])
  campaignId     String?         @db.Char(36)
  campaign       Campaign?       @relation(fields: [campaignId], references: [id])
  expenseDate    DateTime        @db.Date
  amount         Decimal         @db.Decimal(14, 2)
  taxAmount      Decimal         @default(0) @db.Decimal(14, 2)
  description    String          @db.Text
  paymentMethod  PaymentMethod?
  bankAccountId  String?         @db.Char(36)
  bankAccount    BankAccount?    @relation(fields: [bankAccountId], references: [id])
  paidById       String?         @db.Char(36)
  paidBy         User?           @relation("ExpensePaidBy", fields: [paidById], references: [id])
  isReimbursable Boolean         @default(false)
  status         ExpenseStatus   @default(DRAFT)
  receiptFileId  String?         @db.Char(36)
  createdById    String?         @db.Char(36)
  updatedById    String?         @db.Char(36)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([organizationId, expenseNumber])
  @@index([organizationId, expenseDate])
  @@index([organizationId, status])
}

// Cash movements. Income rows come from payments, expense rows from paid expenses.
// Profit and loss and cash flow reports read this table.
model LedgerEntry {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @db.Char(36)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String?      @db.Char(36)
  branch         Branch?      @relation(fields: [branchId], references: [id])
  entryDate      DateTime     @db.Date
  type           LedgerType
  amount         Decimal      @db.Decimal(14, 2)
  bankAccountId  String?      @db.Char(36)
  bankAccount    BankAccount? @relation(fields: [bankAccountId], references: [id])
  sourceType     LedgerSource
  sourceId       String?      @db.Char(36)
  description    String?      @db.Text
  createdAt      DateTime     @default(now())

  @@index([organizationId, entryDate])
  @@index([organizationId, type, entryDate])
}

// ─────────────── 17. Reports & Analytics, 1. Dashboard ───────────────

model SavedReport {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @db.Char(36)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  type           ReportType
  filters        Json
  columns        Json?
  ownerId        String       @db.Char(36)
  owner          User         @relation("ReportOwner", fields: [ownerId], references: [id])
  isShared       Boolean      @default(false)
  scheduleCron   String?
  recipients     Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model ExportJob {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @db.Char(36)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  module         ModuleKey
  format         ExportFormat
  filters        Json?
  status         JobStatus    @default(QUEUED)
  fileId         String?      @db.Char(36)
  error          String?      @db.Text
  requestedById  String       @db.Char(36)
  requestedBy    User         @relation("ExportRequester", fields: [requestedById], references: [id])
  createdAt      DateTime     @default(now())
  completedAt    DateTime?
}

model ImportJob {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @db.Char(36)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  module         ModuleKey
  fileId         String       @db.Char(36)
  status         JobStatus    @default(QUEUED)
  totalRows      Int          @default(0)
  successRows    Int          @default(0)
  failedRows     Int          @default(0)
  errorFileId    String?      @db.Char(36)
  requestedById  String       @db.Char(36)
  requestedBy    User         @relation("ImportRequester", fields: [requestedById], references: [id])
  createdAt      DateTime     @default(now())
  completedAt    DateTime?
}

model DashboardWidget {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @db.Char(36)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String       @db.Char(36)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  widgetKey      String // total_leads, revenue_overview, upcoming_renewals, todays_tasks ...
  layout         Json // x, y, w, h
  config         Json?

  @@unique([userId, widgetKey])
}

model SavedFilter {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @db.Char(36)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String       @db.Char(36)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  module         ModuleKey
  name           String
  filters        Json
  isDefault      Boolean      @default(false)

  @@index([userId, module])
}

// ─────────────── 18. Automation Center ───────────────

model AutomationRule {
  id             String            @id @default(uuid()) @db.Char(36)
  organizationId String            @db.Char(36)
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?           @db.Text
  trigger        AutomationTrigger
  conditions     Json? // e.g. {"source": "Meta Ads", "estimatedValue": {"gte": 50000}}
  scheduleCron   String? // for trigger = SCHEDULE
  isActive       Boolean           @default(true)
  runCount       Int               @default(0)
  lastRunAt      DateTime?
  createdById    String?           @db.Char(36)
  updatedById    String?           @db.Char(36)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  actions AutomationAction[]
  runs    AutomationRun[]

  @@index([organizationId, trigger, isActive])
}

model AutomationAction {
  id           String               @id @default(uuid()) @db.Char(36)
  ruleId       String               @db.Char(36)
  rule         AutomationRule       @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  position     Int                  @default(0)
  type         AutomationActionType
  config       Json // template id, assignee, field values ...
  delayMinutes Int                  @default(0)
}

model AutomationRun {
  id             String         @id @default(uuid()) @db.Char(36)
  organizationId String         @db.Char(36)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ruleId         String         @db.Char(36)
  rule           AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  entityType     EntityType?
  entityId       String?        @db.Char(36)
  status         JobStatus      @default(QUEUED)
  startedAt      DateTime       @default(now())
  finishedAt     DateTime?
  error          String?        @db.Text
  log            Json?

  @@index([organizationId, ruleId, startedAt])
}

model LeadAssignmentRule {
  id                String             @id @default(uuid()) @db.Char(36)
  organizationId    String             @db.Char(36)
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name              String
  strategy          AssignmentStrategy
  conditions        Json?
  assigneeIds       Json? // user ids in rotation order
  lastAssignedIndex Int                @default(0)
  priority          Int                @default(0)
  isActive          Boolean            @default(true)
}

// ─────────────── 19. Communication Center ───────────────

model MessageTemplate {
  id                   String              @id @default(uuid()) @db.Char(36)
  organizationId       String              @db.Char(36)
  organization         Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channel              NotificationChannel
  key                  String // quotation_sent, payment_reminder_1, renewal_due_30 ...
  name                 String
  subject              String?             @db.VarChar(500)
  body                 String              @db.Text
  variables            Json?
  whatsappTemplateName String? // the name approved in WhatsApp Business
  whatsappLanguage     String?
  isActive             Boolean             @default(true)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  messages Message[]

  @@unique([organizationId, channel, key])
}

// Every email, WhatsApp message and SMS, in or out.
model Message {
  id                String              @id @default(uuid()) @db.Char(36)
  organizationId    String              @db.Char(36)
  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channel           NotificationChannel
  direction         Direction
  entityType        EntityType?
  entityId          String?             @db.Char(36)
  leadId            String?             @db.Char(36)
  lead              Lead?               @relation(fields: [leadId], references: [id])
  customerId        String?             @db.Char(36)
  customer          Customer?           @relation(fields: [customerId], references: [id])
  contactId         String?             @db.Char(36)
  contact           Contact?            @relation(fields: [contactId], references: [id])
  templateId        String?             @db.Char(36)
  template          MessageTemplate?    @relation(fields: [templateId], references: [id])
  fromAddress       String              @db.VarChar(500)
  toAddress         String              @db.VarChar(500)
  subject           String?             @db.VarChar(500)
  body              String              @db.Text
  status            MessageStatus       @default(QUEUED)
  providerMessageId String?
  threadKey         String?
  error             String?             @db.Text
  sentById          String?             @db.Char(36)
  sentBy            User?               @relation("MessageSender", fields: [sentById], references: [id])
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  createdAt         DateTime            @default(now())

  @@index([organizationId, entityType, entityId])
  @@index([organizationId, channel, createdAt])
  @@index([providerMessageId])
}

model Notification {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @db.Char(36)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String       @db.Char(36)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           String // lead.assigned, task.due, invoice.overdue ...
  title          String       @db.VarChar(500)
  body           String?      @db.Text
  entityType     EntityType?
  entityId       String?      @db.Char(36)
  link           String?      @db.VarChar(500)
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([userId, readAt, createdAt])
}

model NotificationPreference {
  id       String  @id @default(uuid()) @db.Char(36)
  userId   String  @db.Char(36)
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventKey String
  inApp    Boolean @default(true)
  email    Boolean @default(true)
  whatsapp Boolean @default(false)

  @@unique([userId, eventKey])
}

// SMTP, WhatsApp Business API, SMS, payment gateway and storage settings per organization.
model IntegrationSetting {
  id               String              @id @default(uuid()) @db.Char(36)
  organizationId   String              @db.Char(36)
  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider         IntegrationProvider
  config           Json // non-secret settings: host, port, sender id, phone number id
  secretCiphertext Bytes?
  secretIv         Bytes?
  secretAuthTag    Bytes?
  isActive         Boolean             @default(false)
  lastVerifiedAt   DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@unique([organizationId, provider])
}

// Raw inbound webhooks (WhatsApp delivery receipts and replies, payment gateway events).
model WebhookEvent {
  id             String              @id @default(uuid()) @db.Char(36)
  organizationId String?             @db.Char(36) // resolved after the payload is verified
  provider       IntegrationProvider
  eventType      String
  externalId     String?
  payload        Json
  status         JobStatus           @default(QUEUED)
  receivedAt     DateTime            @default(now())
  processedAt    DateTime?

  @@unique([provider, externalId])
}

// Transactional outbox: domain events written in the same transaction as the change,
// then published to the job queue. Automations, notifications and future AI features consume them.
model OutboxEvent {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @db.Char(36)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  eventType      String // lead.created, quotation.approved, invoice.overdue ...
  aggregateType  String
  aggregateId    String       @db.Char(36)
  payload        Json
  status         OutboxStatus @default(PENDING)
  attempts       Int          @default(0)
  createdAt      DateTime     @default(now())
  publishedAt    DateTime?

  @@index([status, createdAt])
}
